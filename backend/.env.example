# ── Application ──────────────────────────────────────────────
APP_NAME=OWNLY
ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=8000

# ── Database ─────────────────────────────────────────────────
# Dockerized Postgres is published on host port 5433 (5432 is often taken
# by a native Windows PostgreSQL service — see docs/decisions/D-006).
DATABASE_URL=postgresql+psycopg2://ownly:ownly_secret@localhost:5433/ownly

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Security ─────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Storage (local | s3) ─────────────────────────────────────
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./storage_data
# S3 / Cloudflare R2 / MinIO (used when STORAGE_PROVIDER=s3)
S3_ENDPOINT_URL=
S3_BUCKET=ownly-documents
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_FORCE_PATH_STYLE=false
S3_SIGNATURE_VERSION=s3v4

# ── OCR (tesseract | google_vision) ──────────────────────────
OCR_PROVIDER=tesseract
GOOGLE_VISION_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CREDENTIALS_JSON=
# Windows: install https://github.com/UB-Mannheim/tesseract/wiki then set:
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# ── Push notifications (noop | fcm) ──────────────────────────
PUSH_PROVIDER=noop
FCM_CREDENTIALS_PATH=
FCM_CREDENTIALS_JSON=

# ── Admin bootstrap ──────────────────────────────────────────
ADMIN_EMAIL=admin@ownly.local
ADMIN_PASSWORD=change-me-admin

# ── Plans / monetization ─────────────────────────────────────
# Active products allowed on the free tier (premium is unlimited).
FREE_PRODUCT_LIMIT=10

# ── Observability ────────────────────────────────────────────
# Analytics: log (structured logs, default) | noop
ANALYTICS_PROVIDER=log
# Error tracking: leave empty to disable Sentry entirely.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
